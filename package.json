{
  "name": "@sovereignops/root",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first encrypted workspace with policy-gated AI agent operations.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "check": "node scripts/node-check.mjs && npm run typescript:check",
    "typescript:check": "tsc --noEmit -p tsconfig.alpha.json",
    "env:check": "python scripts/env_guard.py",
    "rust:guard": "python scripts/rust_guard.py",
    "smoke": "python scripts/smoke.py",
    "health": "python scripts/status_dashboard.py --json",
    "loc": "python scripts/loc_budget.py --summary",
    "openapi:check": "python scripts/validate_openapi.py",
    "fixtures:check": "python scripts/fixture_drift.py --json",
    "queue": "python scripts/task_queue.py",
    "test": "python -m unittest discover -s tests"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/automation",
    "services/mcp-gateway",
    "services/sync"
  ],
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
