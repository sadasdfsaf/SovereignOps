{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sovereignops.local/attachments.schema.json",
  "title": "Attachment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspaceId",
    "status",
    "risk",
    "createdAt",
    "updatedAt",
    "targetId",
    "filename",
    "contentType",
    "byteSize",
    "uploadedByActorId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^att_[A-Za-z0-9_-]{1,88}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^wsp_[A-Za-z0-9_-]{1,88}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed",
        "deleted"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "targetId": {
      "type": "string",
      "pattern": "^(doc|prj|inc|cmt|att|apv|obj)_[A-Za-z0-9_-]{1,88}$"
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "contentType": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "byteSize": {
      "type": "integer",
      "minimum": 0
    },
    "uploadedByActorId": {
      "type": "string",
      "pattern": "^act_[A-Za-z0-9_-]{1,88}$"
    }
  }
}
