{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sovereignops.local/projects.schema.json",
  "title": "Project record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspaceId",
    "status",
    "risk",
    "createdAt",
    "updatedAt",
    "name",
    "ownerActorId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^prj_[A-Za-z0-9_-]{1,88}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^wsp_[A-Za-z0-9_-]{1,88}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "paused",
        "completed",
        "archived"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "ownerActorId": {
      "type": "string",
      "pattern": "^act_[A-Za-z0-9_-]{1,88}$"
    }
  }
}
