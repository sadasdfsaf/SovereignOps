{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sovereignops.local/api/error-response.schema.json",
  "title": "API error response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "api-error/v1"
    },
    "error": {
      "title": "API error",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "bad_request",
            "unauthenticated",
            "forbidden",
            "not_found",
            "conflict",
            "validation_failed",
            "rate_limited",
            "internal_error",
            "service_unavailable"
          ]
        },
        "status": {
          "type": "integer",
          "enum": [
            400,
            401,
            403,
            404,
            409,
            422,
            429,
            500,
            503
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._,()\\[\\]-]{0,199}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^req_[A-Za-z0-9_-]{8,96}$"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://schemas.sovereignops.local/api/validation-issue.schema.json",
            "title": "API validation issue",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "required",
                  "invalid_type",
                  "invalid_format",
                  "invalid_value",
                  "too_small",
                  "too_large",
                  "not_allowed",
                  "duplicate",
                  "not_sorted"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^(?:\\$|[A-Za-z][A-Za-z0-9_-]*(?:\\[[0-9]+\\])?(?:\\.[A-Za-z][A-Za-z0-9_-]*(?:\\[[0-9]+\\])?)*)$"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._,()\\[\\]-]{0,199}$"
              },
              "expected": {
                "type": "string",
                "enum": [
                  "array",
                  "boolean",
                  "integer",
                  "number",
                  "object",
                  "string",
                  "non_empty_string",
                  "safe_identifier",
                  "safe_path",
                  "timestamp",
                  "allowed_value",
                  "present",
                  "absent"
                ]
              },
              "received": {
                "type": "string",
                "enum": [
                  "array",
                  "boolean",
                  "integer",
                  "number",
                  "object",
                  "string",
                  "null",
                  "missing",
                  "unknown"
                ]
              }
            },
            "required": [
              "code",
              "path",
              "message"
            ]
          }
        }
      },
      "required": [
        "code",
        "status",
        "message",
        "requestId"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "error"
  ]
}
