{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sovereignops.local/comments.schema.json",
  "title": "Comment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspaceId",
    "status",
    "risk",
    "createdAt",
    "updatedAt",
    "targetId",
    "body",
    "authorActorId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^cmt_[A-Za-z0-9_-]{1,88}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^wsp_[A-Za-z0-9_-]{1,88}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "deleted"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "targetId": {
      "type": "string",
      "pattern": "^(doc|prj|inc|cmt|att|apv|obj)_[A-Za-z0-9_-]{1,88}$"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "authorActorId": {
      "type": "string",
      "pattern": "^act_[A-Za-z0-9_-]{1,88}$"
    }
  }
}
